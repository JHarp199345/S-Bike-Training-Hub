# Python environment (setup.sh rebuilds it from requirements.txt)
.venv
.venv/
__pycache__/
*.log

# Downloaded maps, road data, terrain and tools (setup.sh fetches them)
maps/

# Your own data - it stays on your Mac
rides/
routes/
profile.json
state.json
state.tmp
bests.json
bests.tmp
coach.json
coach.tmp
fitness_cache.json
milestones_cache.json
# The phone remote's PIN and paired-phone tokens
remote.json
remote.tmp
# Strava app keys and tokens (only if you set up Strava posting)
strava.json
strava.tmp
# Activity files and daily steps imported from the watch (personal)
activities/
course_forms.json
# The workout in progress (personal)
resume.json
resume.tmp
# The built MCP bundle (attached to a GitHub release, not committed)
mcpb/*.mcpb

# Personal artwork, settings, recovery and backup records
artwork.json
artwork.tmp
web/sports/phase-user-*
theme.json
theme.tmp
backups/
art_src/
*.before-*

# Private reviewed program drafts and SQLite journals
program-drafts.sqlite3*

# Bike setup: the chosen bike, the request for the assistant, and profiles made on this computer
bike.json
bike_setup.json
bike_setup.tmp
bike_profiles_local/
s-bike-hub.sh
test-results.txt

# Private source documents and unreviewed workout drafts
workout-imports/

# Private music connections; never included in the public app or MCP bundle.
music.json
music.tmp

# Local Claude continuation specs; never publish with the app.
/.claude-handoff/

# Your music and the library built from it (index, cover art, tempo) stay on this computer; never shared
music/
music_library.json
music_library.tmp
music_cache/
*.mp3
*.m4a
*.flac
*.wav
*.aiff
*.ogg
*.opus
